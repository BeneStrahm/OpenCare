# Vorlage fuer den lokalen Entwicklungsmodus (npm run dev:lokal).
# npm run dev:lokal legt server/.env beim ersten Start selbst an und uebernimmt
# Passwort und Schluessel aus der .env im Hauptordner. Die echte server/.env
# nie committen (steht in .gitignore). Nur fuer den eigenen Rechner.

# Datenbank in Docker, nur ueber 127.0.0.1 erreichbar (docker-compose.dev.yml)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=opencare
POSTGRES_USER=opencare
# Muss zum Passwort der Datenbank passen (POSTGRES_PASSWORD in der .env im Hauptordner)
POSTGRES_PASSWORD=

SERVER_PORT=3001
NODE_ENV=development
TZ=Europe/Berlin

# Mindestens 32 Zeichen, zufaellig
JWT_SECRET=

# Vite laeuft auf 5173, die Docker-App auf 3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
REGISTRATION_ENABLED=true

# Web Push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:test@example.org
